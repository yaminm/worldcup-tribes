# Copy to .env and fill in. Defaults below work with docker-compose for local dev.

# Postgres connection string
DATABASE_URL="postgresql://tribes:tribes@localhost:5433/tribes?schema=public"

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Google OAuth credentials (required in production)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Dev-only credentials login. MUST be "false" (or unset) in production.
ENABLE_DEV_LOGIN="false"

# Comma-separated emails granted global superadmin powers (match sync/results)
ADMIN_EMAILS=""

# football-data.org API token. Leave empty to use the bundled JSON fixtures.
FOOTBALL_DATA_API_TOKEN=""

# Shared secret the cron/sync endpoint requires (Authorization: Bearer <secret>)
CRON_SECRET=""
